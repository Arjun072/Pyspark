from pyspark.sql.functions import *
from pyspark.sql.window import Window

data = [
    (1,"Alice","Sales",50000,"2021-03-15"),
    (2,"Bob","IT",70000,"2020-07-22"),
    (3,"Charlie","Sales",60000,"2019-11-01"),
    (4,"Diana","HR",45000,"2022-01-10"),
    (5,"Eve","IT",80000,"2018-05-30"),
    (6,"Frank","HR",47000,"2023-06-18"),
    (None,"Ghost",None,None,None)
]

columns = ["id","name","department","salary","join_date"]

df = spark.createDataFrame(data, columns)
df = df.withColumn("join_date", to_date(col("join_date")))


df.filter(
    col("id").isNull() |
    col("department").isNull() |
    col("salary").isNull()
).select("id","name","department","salary").show()
